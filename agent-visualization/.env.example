# 可视化智能体的大模型配置（OpenAI 兼容）
# 复制为 .env 后填写；也可以直接使用项目根目录 .env 的 DEEPSEEK_API_KEY
# 所有回答默认走这里的在线模型；未配置时提问会直接报配置错误（无离线兜底）
VIZ_LLM_API_KEY=
VIZ_LLM_BASE_URL=https://api.deepseek.com
VIZ_LLM_MODEL=deepseek-chat

# YOLO 缺陷检测（可选；默认读取项目根目录权重与 .venv）
# VIZ_PYTHON=/path/to/python
# VIZ_YOLO_MODEL=results/week2_3/yolo/train/weights/best.pt
# VIZ_YOLO_CONF=0.25

# 设备看板机器人推送（可选）
# 钉钉/企业微信自定义机器人 Webhook；未配置时看板仍可用，推送接口返回 503
# VIZ_ALERT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxx
